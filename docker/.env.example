# mflowy 环境变量模板 — 复制为 .env 使用（.env 已被 .gitignore 忽略）

# MLflow 追踪服务地址（实验 / Run / 产物存储）
# 未设置时：workflow 与 mlflow 查询工具同落固定本地库 sqlite:///~/.mflowy/mlflow.db（跨任务持久，与 task_dir 解耦）
MLFLOW_TRACKING_URI=postgresql://user:password@host.docker.internal:5432/mlflow

# JobProvider：local（本地直跑，需 [job] extra）| module:Class（远程，如 agentic.job_provider:RemoteJobProvider）
# provider 模块经宿主 sys.path 解析：PYTHONPATH 指向 agentic 分支 checkout 根（仅暴露 agentic 顶层包）
MFLOWY_JOB_PROVIDER=local
